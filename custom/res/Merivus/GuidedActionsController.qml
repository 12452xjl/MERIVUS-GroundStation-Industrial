               ok: false, reason: "current_call_invalidated_or_retirement_unconfirmed", currentScopeBlocked: true,
               priorOperationEffectsUnknown: true, executable: false, startupPermitGranted: false, flightCommandReleased: false
           }
           return run("current", null, action, deniedResult, work)
       }
       function runObservation(purpose, workflow, action, deniedResult, work) {
           if (transitionInProgress()) return deniedResult
           if (purpose !== "selected-observation" && purpose !== "retained-close") return deniedResult
           return run(purpose, workflow, action, deniedResult, work)
       }
       function run(purpose, workflow, action, deniedResult, work) {
           var guard = lifetime, factory = _fleetDeploymentLifecycle, controller = _root
           var denied = deniedResult === false ? false : {
               ok: false, reason: "native_controller_call_not_current", executable: false,
               startupPermitGranted: false, flightCommandReleased: false
           }
           if (denied !== false && deniedResult && typeof deniedResult.reason === "string")
               denied.reason = deniedResult.reason.substring(0, 128)
           if (!guard.alive || transitionState.busy === true || transitionBusy || typeof work !== "function") return denied
           var ticket = null, call = null, callId = "", result = denied, originalState = null
           var accepted = false, ended = false, invoked = false, workReturned = false
           try {
               ticket = factory.beginControllerCall(controller, purpose, workflow)
               if (ticket && ticket.ok === true && typeof ticket.callId === "string") callId = ticket.callId
               if (!guard.alive || !ticket || Object.keys(ticket).length !== 6 || !callId
                       || ticket.purpose !== purpose || ticket.authorityGranted !== false || ticket.flightCommandReleased !== false
                       || !ticket.scope || Object.keys(ticket.scope).length !== 22
                       || factory.controllerCallMatches(controller, callId) !== true) return denied
               call = {scope: ticket.scope, callId: callId, action: action, onStale: null}
               originalState = {callId: callId, purpose: purpose, invalidated: false}
               activeCallState = originalState
               if (!guard.alive || originalState.invalidated === true
                       || factory.controllerCallMatches(controller, callId) !== true) return denied
               invoked = true
               result = work(call)
               workReturned = true
               accepted = guard.alive && originalState.invalidated !== true && factory.controllerCallMatches(controller, callId) === true
           } catch (error) { accepted = false }
           finally {
               if (guard.alive && callId) {
                   if (originalState && originalState.purpose === "current" && originalState.invalidated === true) {
                       var retired = false
                       try { retired = controller._cancelFleetOriginalScopeIntents(call.scope) === true }
                       catch (retireError) { retired = false }
                       // A failed local cancellation is not a reason to
                       // reopen async native gates after the outer stack exits.
                       if (guard.alive && !retired) retiredCurrentScope = call.scope
                   }
                   if (guard.alive && !accepted && call && typeof call.onStale === "function") {
                       try { call.onStale() } catch (cleanupError) { /* Only an original-scope cleanup was permitted. */ }
                   }
                   if (guard.alive) {
                       try { ended = factory.endControllerCall(controller, callId) === true }
                       catch (endError) { ended = false }
                   }
                   if (guard.alive && activeCallState === originalState) {
                       if (ended) activeCallState = null
                       else if (originalState) originalState.invalidated = true
                   }
               }
           }
           // Never return success from inside try: failed exact cleanup must
           // remain a failure. A missing owner is not an automatic unlock.
           if (accepted && ended) return result
           if (denied === false || !invoked) return denied
           // A post-call fence is NOT rollback. Preserve returned native
           // queued/may-have-committed facts; an interrupted call is unknown,
           // not a fabricated `flightCommandReleased: false` outcome.
           var uncertain = {}
           if (workReturned && result && typeof result === "object" && !Array.isArray(result)) {
               var keys = Object.keys(result)
               for (var i = 0; i < keys.length; ++i) uncertain[keys[i]] = result[keys[i]]
               uncertain.nativeReason = typeof result.reason === "string" ? result.reason.substring(0, 128) : ""
           }
           uncertain.ok = false
           uncertain.reason = "controller_call_result_not_verified"
           uncertain.controllerCallVerified = false
           uncertain.nativeResultReturned = workReturned
           uncertain.effectMayHaveOccurred = true
           if (uncertain.flightCommandReleased === undefined) uncertain.flightCommandReleased = null
           return uncertain
       }
    }
