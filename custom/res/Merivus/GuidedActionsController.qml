    property var _actionData
    // Every Guided action gets a one-shot confirmation token in addition to
    // the frozen actionData identity.  actionData alone is insufficient for
    // single-vehicle actions whose payload is undefined or a primitive, and
    // allowed action codes must never be callable through a copied payload.
    // Keep the expected token in an unexported child-object id instead of a
    // controller property. QML callers can still invoke executeAction(), but
    // cannot read the expected token to manufacture a valid fifth argument.
    QtObject {
        id: _actionConfirmationState
        property var token
        property string dataFingerprint: ""
        property int sequence: 0
    }
    // Resume uploads are asynchronous. Keep the confirmed vehicle identity
    // and index in lexical child-object state until MissionController signals
    // that the generated plan is ready; this is not a public controller
    // property that another QML surface can overwrite.
    QtObject {
        id: _resumeMissionConfirmationState
        property var value: ({})
        property double sequence: 0
    }
    // Standard mission starts also carry a per-vehicle immutable mission
    // fingerprint captured after the confirmation preflight.  It prevents a
    // MissionManager replacement between the dialog and delayed dispatch
    // from being treated as the reviewed mission.
    QtObject {
        id: _missionStartConfirmationState
        property var fingerprints: ({})
    }
    // Frozen by requestControlCommand() and consumed only by the matching
    // dedicated action code.  This prevents an active-vehicle switch while the
    // confirmation slider is open from retargeting a typed parameter.
    property var _manualControlSnapshot: ({})
    property int _manualControlSequence: 0
    // Custom MAV_CMD actions are kept behind the same confirmation surface as
    // other Guided actions. The QObject reference remains internal; the
    // confirmation payload contains only a label, request id and vehicle id.
    property var _customActionPending: ({})
    property int _customActionSequence: 0
    property var _flightModePending: ({})
    property int _flightModeSequence: 0
    // Snapshot used only by the map Goto confirmation/execution pair. The
    // coordinate remains in _actionData so the map indicator contract is
    // unchanged.
    property int _actionTargetVehicleId: 0
    property var _actionTargetVehicleIds: []
    property int _confirmedSetWaypointItemCount: -1

    function _confirmationDataFingerprint(actionCode, actionData) {
        if (actionData === undefined || actionData === null) return String(actionCode) + ":null"
        var serialized = ""
        try {
            serialized = JSON.stringify(actionData)
        } catch (error) {
            serialized = String(actionData)
        }
        return String(actionCode) + ":" + serialized
    }

    function _issueActionConfirmationToken(actionCode, actionData) {
        var guard = _fleetControllerCallBridge.lifetime, state = _formationQueueWorkflow.state
        var queuedOrigin = actionCode === actionSwarm ? state.opening : null
        _actionConfirmationState.sequence = (_actionConfirmationState.sequence + 1) % 2147483647
        if (!guard.alive) return
        if (_actionConfirmationState.sequence <= 0) _actionConfirmationState.sequence = 1
        if (!guard.alive) return
        _actionConfirmationState.dataFingerprint = _confirmationDataFingerprint(actionCode, actionData)
        if (!guard.alive) return
        var issuedToken = {
            tokenId: "guided-" + new Date().getTime() + "-"
                      + _actionConfirmationState.sequence,
            actionCode: actionCode,
            actionData: actionData,
            formationQueueOrigin: !!queuedOrigin,
            dataFingerprint: _actionConfirmationState.dataFingerprint,
            issuedAtMs: new Date().getTime()
        }
        _actionConfirmationState.token = issuedToken
        if (!guard.alive) return
        if (confirmDialog) confirmDialog.setConfirmationToken(issuedToken)
        if (!guard.alive) return
        if (queuedOrigin && state.opening === queuedOrigin && !queuedOrigin.cancelled
                && state.confirmation === queuedOrigin.invocation && _actionConfirmationState.token === issuedToken) {
            queuedOrigin.actionToken = issuedToken
            queuedOrigin.actionData = actionData
            state.pending = queuedOrigin
            state.opening = null
        }
        // Never return this capability from a publicly callable QML method.
    }

    function _invalidateActionConfirmationToken(queuedReceipt) {
        var guard = _fleetControllerCallBridge.lifetime
        _retireFormationQueueReview(queuedReceipt)
        _actionConfirmationState.token = undefined
        if (!guard.alive) return
        _actionConfirmationState.dataFingerprint = ""
        if (!guard.alive) return
        if (confirmDialog) confirmDialog.clearConfirmationToken()
    }

    function _actionConfirmationValid(actionCode, actionData, token) {
        var expected = _actionConfirmationState.token
        var issuedAtMs = expected ? Number(expected.issuedAtMs) : NaN
        var ageMs = isFinite(issuedAtMs) ? new Date().getTime() - issuedAtMs : -1
        return expected && token && token === expected
                && expected.actionCode === actionCode
                && expected.actionData === _actionData
                && actionData === _actionData
                && expected.dataFingerprint === _actionConfirmationState.dataFingerprint
                && expected.dataFingerprint === _confirmationDataFingerprint(actionCode, actionData)
                && isFinite(issuedAtMs) && ageMs >= 0 && ageMs <= 120000
    }

    on_FlightModeChanged: {
        _vehiclePaused =        _activeVehicle ? _flightMode === _activeVehicle.pauseFlightMode : false
        _vehicleInRTLMode =     _activeVehicle ? _flightMode === _activeVehicle.rtlFlightMode || _flightMode === _activeVehicle.smartRTLFlightMode : false
        _vehicleInLandMode =    _activeVehicle ? _flightMode === _activeVehicle.landFlightMode : false
        _vehicleInMissionMode = _activeVehicle ? _flightMode === _activeVehicle.missionFlightMode : false // Must be last to get correct signalling for showStartMission popups
    }

    Connections {
        target:                     missionController
        function onResumeMissionUploadFailForRequest(requestId, operationId) {
            var context = _resumeMissionConfirmationState.value
            if (!context || context.phase !== "uploading" || !context.vehicleId
                    || typeof requestId !== "string" || requestId !== context.requestId
                    || typeof operationId !== "string" || !/^[1-9][0-9]{0,19}$/.test(operationId)) {
                if (_fleetEventBlackBox) {
                    _fleetEventBlackBox.record("mission.resume_upload_fail_ignored",
                                               { reason: "no_active_resume_request",
                                                 flightCommandReleased: false },
                                               "GuidedActionsController")
                }
                return
            }
            var issuedAtMs = Number(context.issuedAtMs)
            var ageMs = isFinite(issuedAtMs) ? new Date().getTime() - issuedAtMs : -1
            if (!isFinite(issuedAtMs) || ageMs < 0 || ageMs > 120000) {
                _resumeMissionConfirmationState.value = ({})
                if (_fleetEventBlackBox) {
                    _fleetEventBlackBox.record("mission.resume_upload_fail_ignored",
                                               { reason: "resume_request_expired",
                                                 requestId: String(context.requestId),
                                                 ageMs: ageMs,
                                                 flightCommandReleased: false },
                                               "GuidedActionsController")
                }
                return
            }
            // Native signals carry the exact original request and operation.
            // Retrying still requires a fresh visible operator confirmation.
            confirmAction(actionResumeMissionUploadFail, {
                              vehicleId: Number(context.vehicleId),
                              resumeContext: context
                          })
        }
        function onResumeMissionReadyForRequest(requestId, operationId, uploadedItemCount, contentFingerprint) {
            _startResumedMission(requestId, operationId, uploadedItemCount, contentFingerprint)
        }
    }

