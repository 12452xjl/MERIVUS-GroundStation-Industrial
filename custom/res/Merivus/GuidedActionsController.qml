    // Public QML must not receive the raw FleetRegistry/FleetHealthCenter
    // objects.  Both QObjects intentionally retain backend setters for the
    // trusted adapter path; exposing them here would let another panel replace
    // the health source or change an offline timeout immediately before a
    // command gate is evaluated.  These facades contain only read snapshots
    // and query methods.
    QtObject {
       id: _fleetRegistryFacade
       readonly property int vehicleCount: _swarm && _swarm.fleetRegistry
                                           ? _swarm.fleetRegistry.vehicleCount : 0
       readonly property int onlineVehicleCount: _swarm && _swarm.fleetRegistry
                                                 ? _swarm.fleetRegistry.onlineVehicleCount : 0
       readonly property int healthyVehicleCount: _swarm && _swarm.fleetRegistry
                                                  ? _swarm.fleetRegistry.healthyVehicleCount : 0
       readonly property var vehicles: _swarm && _swarm.fleetRegistry
                                      ? _swarm.fleetRegistry.vehicles : []
       readonly property var fleetHealthSummary: _swarm && _swarm.fleetRegistry
                                                 ? _swarm.fleetRegistry.fleetHealthSummary : ({})
       function containsVehicle(systemId) {
           return _swarm && _swarm.fleetRegistry
                   ? _swarm.fleetRegistry.containsVehicle(Number(systemId)) : false
       }
       function vehicle(systemId) {
           return _swarm && _swarm.fleetRegistry
                   ? _swarm.fleetRegistry.vehicle(Number(systemId)) : ({})
       }
       function onlineVehicles() {
           return _swarm && _swarm.fleetRegistry
                   ? _swarm.fleetRegistry.onlineVehicles() : []
       }
       function vehiclesWithCapability(capability, requireVerified) {
           return _swarm && _swarm.fleetRegistry
                   ? _swarm.fleetRegistry.vehiclesWithCapability(String(capability || ""),
                                                                  requireVerified === true) : []
       }
       function configurationFingerprint(configuration) {
           return _swarm && _swarm.fleetRegistry
                   ? _swarm.fleetRegistry.configurationFingerprint(configuration || {}) : ""
       }
       function configurationApproval(systemId) {
           return _swarm && _swarm.fleetRegistry
                   ? _swarm.fleetRegistry.configurationApproval(Number(systemId)) : ({})
       }
    }

    // Link metrics are optional in the registry snapshot.  Read them from
    // the descriptor or its metadata only when the producer supplied a
    // value; preserve the raw QVariant type so FleetLinkDegradationPolicy can
    // reject strings/NaN instead of silently turning bad evidence into an
    // apparently missing healthy metric.
    function _linkEvidenceValue(report, aliases) {
        var sources = [report,
                       report && report.metadata ? report.metadata : null,
                       report && report.linkMetrics ? report.linkMetrics : null]
        for (var sourceIndex = 0; sourceIndex < sources.length; sourceIndex++) {
            var source = sources[sourceIndex]
            if (!source) continue
            for (var aliasIndex = 0; aliasIndex < aliases.length; aliasIndex++) {
                var key = aliases[aliasIndex]
                if (source[key] !== undefined && source[key] !== null) {
                    // Registry uses numeric -1 as an explicit “not observed”
                    // sentinel. Treat only that real numeric sentinel as
                    // absent; string "-1" remains invalid evidence.
                    if (typeof source[key] === "number" && source[key] === -1) continue
                    return { found: true, value: source[key] }
                }
            }
        }
        return { found: false, value: undefined }
    }

    QtObject {
       id: _fleetHealthFacade
       readonly property var healthSummary: _fleetHealthCenter ? _fleetHealthCenter.healthSummary : ({})
       readonly property var vehicleHealth: _fleetHealthCenter ? _fleetHealthCenter.vehicleHealth : []
       function evaluateTakeoffGate(vehicleIds) {
           return _fleetHealthCenter
                   ? _fleetHealthCenter.evaluateTakeoffGate(vehicleIds || [])
                   : ({ allowed: false, state: "source_unavailable", reasons: [] })
       }
       function evaluateTaskGate(vehicleIds, requireLeader) {
           if (requireLeader !== undefined && requireLeader !== true
                   && requireLeader !== false) {
               return { allowed: false, state: "invalid_input",
                        reasons: [{ vehicleId: 0, code: "invalid_require_leader",
                                    severity: "block",
                                    message: qsTr("任务门禁的 Leader 要求必须是布尔值。") }] }
           }
           return _fleetHealthCenter
                   ? _fleetHealthCenter.evaluateTaskGate(vehicleIds || [],
                                                         requireLeader === undefined
                                                         ? true : requireLeader === true)
                   : ({ allowed: false, state: "source_unavailable", reasons: [] })
       }
    }

